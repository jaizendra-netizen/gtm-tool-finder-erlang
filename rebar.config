{erl_opts, [debug_info]}.
{deps, []}.
{project_plugins, [rebar3_hex, rebar3_ex_doc]}.
{escript_main_app, gtm_tool_finder_erl}.
{escript_name, gtm_tool_finder}.
{ex_doc, [
    {extras, ["README.md"]},
    {main, "README.md"},
    {source_url, "https://github.com/jaizendra-netizen/gtm-tool-finder-erlang"},
    {homepage_url, "https://www.onegtmlab.dev"}
]}.
{hex, [{doc, ex_doc}]}.
{escript_incl_extra, [{"gtm_tool_finder_erl/priv/*", "_build/default/lib/"}]}.
